local.file_match "ostad_logs" {
  path_targets = [
    {
      __path__ = "/var/log/ostad-monitoring.log",
      job      = "ostad-monitoring",
    },
  ]
}

loki.source.file "ostad_logs" {
  targets    = local.file_match.ostad_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
